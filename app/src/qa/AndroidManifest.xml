<?xml version="1.0" encoding="utf-8"?>
<!-- mqa QA seeds (skill qa-seeds): merged into debug and uat only. The DUMP permission is held by adb shell and
     cannot be granted to normal apps, so only adb can send the seed broadcast. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="org.fossify.calendar.qa.QaSeedReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="org.fossify.calendar.QA_SEED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
