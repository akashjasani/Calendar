    {"tag": "YearFragmentsHolder", "roles": ["user"], "openedBy": "Yearly view"},
    {"tag": "EventListFragment", "roles": ["user"], "openedBy": "Simple event list", "scroll": {"depth": 10, "expects": ["text"]}},
