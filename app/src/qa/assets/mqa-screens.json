    {"tag": "TaskActivity", "roles": ["user"], "openedBy": "New Task", "needs": "the setting Allow creating tasks on (the default)"},
    {"tag": "SelectTimeZoneActivity", "roles": ["user"], "needs": "the setting Allow changing event time zones on (off by default)", "note": "opened from the time zone row of EventActivity"},
